# Copy this file to .env and fill in your own local PostgreSQL credentials.
# .env is listed in .gitignore and must NEVER be committed.

# Preferred: a single connection string. If set, this wins over the DB_*
# variables below (both here and in CI, where the GitHub Actions workflow
# sets it to point at the disposable Postgres service container instead).
# DATABASE_URL=postgresql+psycopg://postgres:@localhost:5432/gradcafe

# Fallback / Module 3-compatible individual settings (used only if
# DATABASE_URL is unset):
DB_NAME=gradcafe
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Used by the pytest suite's db/integration tests -- a throwaway database,
# created automatically if it doesn't exist yet. Never point this at your
# real gradcafe database.
DB_NAME_TEST=gradcafe_test
# TEST_DATABASE_URL=postgresql+psycopg://postgres:@localhost:5432/gradcafe_test

# Used by Flask to sign session/flash cookies. Any random string is fine for
# local development -- generate one with: python -c "import secrets; print(secrets.token_hex(16))"
FLASK_SECRET_KEY=change-me-to-something-random
